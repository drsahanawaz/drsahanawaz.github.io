{% extends "base.html.j2" %}
{% block title %}Research · {{ page.headline }} · {{ site.name }}{% endblock %}
{% block description %}{{ page.lead }}{% endblock %}

{% block content %}
<!-- Group Header -->
<section class="lab-hero page-hero--visual page-hero--data">
  <div class="shell">
    <p class="section-kicker">{{ page.group_type }}</p>
    <h1 class="lab-title">{{ page.headline }}</h1>
    <p class="lab-subtitle">{{ page.subheadline }}</p>
    {% if page.ethos %}
    <p class="lab-ethos"><strong>Core Identity:</strong> {{ page.ethos }}</p>
    {% endif %}
    <p class="lab-affiliation">
      {{ page.affiliation_primary }}<br>
      <span class="muted">Doctoral Lineage: {{ page.doctoral_lineage }}</span>
    </p>
    <p class="lead lab-lead">{{ page.lead }}</p>

    <!-- Quick Navigation -->
    <nav class="lab-quicknav" aria-label="Page navigation">
      <a href="#about-lead">Researcher Profile</a>
      <a href="#research-areas">Research Areas</a>
      <a href="#phd-foundation">Doctoral Foundation</a>
      <a href="#methods">Methods & Stack</a>
      <a href="#tools">Software & Web Tools</a>
      <a href="#publications">Publications</a>
      <a href="#collaboration">Collaborations & Inquiries</a>
      <a href="#milestones">Chronology</a>
    </nav>
  </div>
</section>

<!-- Researcher Profile Card -->
<section class="section section-visual section-visual--lab" id="about-lead">
  <div class="shell">
    <div class="pi-profile-card">
      <div class="pi-avatar-col">
        <img class="pi-photo" src="{{ site.portrait }}" alt="Dr. Md Sahanawaz">
      </div>
      <div class="pi-info-col">
        <div class="pi-header">
          <span class="section-kicker">{{ page.lead_researcher.role }}</span>
          <h2>{{ page.lead_researcher.name }}, <span class="degrees">{{ page.lead_researcher.degrees }}</span></h2>
          <p class="pi-role">{{ page.lead_researcher.designation }}</p>
          <p class="pi-inst">{{ page.lead_researcher.institution }}</p>
        </div>
        <div class="pi-bio">
          <p>{{ page.lead_researcher.bio }}</p>
        </div>
        <div class="pi-credentials-row">
          <span class="cred-chip">CSIR-NET (AIR 17)</span>
          <span class="cred-chip">GATE</span>
          <span class="cred-chip">JAM</span>
          <span class="cred-chip">WBPSC Selection</span>
        </div>
        <div class="pi-links-bar">
          <a class="pi-link-chip" href="{{ page.lead_researcher.orcid_url }}" rel="noopener noreferrer" target="_blank">
            <span class="chip-icon">iD</span> ORCID: {{ page.lead_researcher.orcid }}
          </a>
          <a class="pi-link-chip" href="{{ page.lead_researcher.scholar_url }}" rel="noopener noreferrer" target="_blank">
            <span class="chip-icon">GS</span> Google Scholar
          </a>
          <a class="pi-link-chip" href="{{ page.lead_researcher.github_url }}" rel="noopener noreferrer" target="_blank">
            <span class="chip-icon">GH</span> GitHub
          </a>
          <a class="pi-link-chip" href="{{ page.lead_researcher.linkedin_url }}" rel="noopener noreferrer" target="_blank">
            <span class="chip-icon">in</span> LinkedIn
          </a>
          <a class="pi-link-chip" href="mailto:{{ page.lead_researcher.email_official }}">
            <span class="chip-icon">✉</span> {{ page.lead_researcher.email_official }}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="visual-break visual-break--molecules" role="presentation" aria-hidden="true"></div>

<!-- Research Areas -->
<section class="section section-visual section-visual--molecules" id="research-areas">
  <div class="shell">
    <div class="section-heading">
      <span class="section-kicker">Research Areas</span>
      <h2>Current Research Focus</h2>
      <p class="lead">Our computational investigations span rigorous model evaluation, interpretability, uncertainty quantification, and predictive modeling for chemical systems.</p>
    </div>

    <div class="thrust-grid">
      {% for area in page.research_areas %}
      <article class="thrust-card" id="{{ area.id }}">
        <div class="thrust-top">
          <span class="thrust-num">{{ area.number }}</span>
        </div>
        <h3 class="thrust-title">{{ area.title }}</h3>
        <p class="thrust-summary">{{ area.summary }}</p>
        <div class="thrust-techniques">
          <ul class="tag-cloud">
            {% for kw in area.keywords %}
            <li>{{ kw }}</li>
            {% endfor %}
          </ul>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Doctoral Research Foundation -->
<section class="section section-visual section-visual--dim" id="phd-foundation">
  <div class="shell">
    <div class="phd-foundation-card">
      <div class="phd-badge-col">
        <span class="section-kicker">Doctoral Research</span>
        <span class="phd-year-badge">{{ page.phd.period }}</span>
        <p class="phd-inst">{{ page.phd.institution }}</p>
        <p class="phd-supervisor">Supervisor: {{ page.phd.supervisor }}</p>
      </div>
      <div class="phd-content-col">
        <h3>{{ page.phd.title }}</h3>
        <p class="meta">{{ page.phd.degree }}</p>
        <p>{{ page.phd.text }}</p>
      </div>
    </div>
  </div>
</section>

<div class="visual-break visual-break--data" role="presentation" aria-hidden="true"></div>

<!-- Computational Methods & Stack -->
<section class="section section-visual section-visual--soft" id="methods">
  <div class="shell">
    <div class="section-heading">
      <span class="section-kicker">Methodology</span>
      <h2>Computational Tools & Environment</h2>
      <p class="lead">We prioritize open-source, reproducible Python workflows for chemical data processing and modeling.</p>
    </div>

    <div class="methods-card-grid">
      {% for item in page.methods_summary %}
      <div class="methods-card">
        <h3>{{ item.category }}</h3>
        <p>{{ item.details }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Software & Web Tools -->
<section class="section section-visual section-visual--dim" id="tools">
  <div class="shell">
    <div class="section-heading">
      <span class="section-kicker">Software</span>
      <h2>Web-Based Tools & Code</h2>
      <p class="lead">Open-access utilities and repositories developed to support laboratory spectroscopists and chemical data analysis.</p>
    </div>

    <div class="tools-showcase-grid">
      {% for tool in page.tools_showcase %}
      <article class="tool-showcase-card">
        <div class="tool-top">
          <span class="badge badge-accent">{{ tool.status }}</span>
        </div>
        <h3 class="tool-name">{{ tool.name }}</h3>
        <p class="tool-subtitle">{{ tool.subtitle }}</p>
        <p class="tool-summary">{{ tool.summary }}</p>
        <div class="tool-tech">
          <strong>Stack:</strong> <code>{{ tool.tech }}</code>
        </div>
        <div class="tool-actions">
          <a class="btn btn-primary btn-sm" href="{{ tool.url }}" rel="noopener noreferrer" target="_blank">
            Open Resource →
          </a>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<div class="visual-break visual-break--molecules" role="presentation" aria-hidden="true"></div>

<!-- Publications -->
<section class="section section-visual section-visual--molecules" id="publications">
  <div class="shell">
    <div class="section-heading">
      <span class="section-kicker">Publications</span>
      <h2>Peer-Reviewed Journal Articles</h2>
      <p class="lead">Scholarly articles published in peer-reviewed international chemistry journals.</p>
    </div>

    <div class="lab-pub-list">
      {% for pub in publications %}
      <article class="lab-pub-item">
        <div class="pub-year-badge">{{ pub.year }}</div>
        <div class="pub-details">
          <div class="pub-meta">
            <span class="journal-name">{{ pub.journal }}</span>
            {% if pub.volume %}<span class="volume-info">· Vol. {{ pub.volume }}</span>{% endif %}
          </div>
          <h3 class="pub-title">{{ pub.title }}</h3>
          {% if pub.authors %}
          <p class="pub-authors">
            <strong>Authors:</strong> {{ pub.authors }}
          </p>
          {% endif %}
          <p class="pub-abstract">{{ pub.summary }}</p>
          {% if pub.topics %}
          <div class="pub-topics">
            {% for topic in pub.topics %}
            <span class="topic-tag">{{ topic }}</span>
            {% endfor %}
          </div>
          {% endif %}
          <div class="pub-links">
            {% if pub.doi %}
            <a class="pub-btn" href="{{ pub.url }}" rel="noopener noreferrer" target="_blank">
              DOI: {{ pub.doi }} ↗
            </a>
            {% endif %}
          </div>
        </div>
      </article>
      {% endfor %}
    </div>

    <div class="pub-profiles-banner">
      <div class="pub-banner-copy">
        <h3>Academic Citation Profiles</h3>
        <p>Complete publication records and citation metrics are available on external scholarly databases.</p>
      </div>
      <div class="pub-banner-links">
        <a class="btn btn-primary" href="{{ site.links.google_scholar }}" rel="noopener noreferrer" target="_blank">Google Scholar Profile ↗</a>
        <a class="btn btn-ghost" href="{{ site.links.orcid }}" rel="noopener noreferrer" target="_blank">ORCID Record ↗</a>
        <a class="btn btn-ghost" href="{{ site.links.github }}" rel="noopener noreferrer" target="_blank">GitHub Profile ↗</a>
      </div>
    </div>
  </div>
</section>

<!-- Collaborations & Inquiries -->
<section class="section section-visual section-visual--lab" id="collaboration">
  <div class="shell">
    <div class="section-heading">
      <span class="section-kicker">Collaboration</span>
      <h2>Research Inquiries & Collaborations</h2>
      <p class="lead">Open to academic collaboration and student project mentorship.</p>
    </div>

    <div class="collab-content-box">
      <p class="collab-statement">{{ page.collaboration.statement }}</p>
      <p class="collab-students">{{ page.collaboration.students_note }}</p>

      <div class="inquiry-contacts-clean">
        <p>
          <strong>Institutional Email:</strong> <a href="mailto:{{ site.email_professional }}">{{ site.email_professional }}</a> &nbsp;·&nbsp;
          <strong>Research Email:</strong> <a href="mailto:{{ site.email_general }}">{{ site.email_general }}</a>
        </p>
      </div>

      <div class="inquiry-actions-clean">
        <a class="btn btn-primary" href="/contact/">Get in Touch →</a>
        <a class="btn btn-ghost" href="{{ site.cv_path }}" rel="noopener noreferrer" target="_blank">Download Curriculum Vitae (PDF)</a>
      </div>
    </div>
  </div>
</section>

<div class="visual-break visual-break--soft" role="presentation" aria-hidden="true"></div>

<!-- Chronology -->
<section class="section section-visual section-visual--dim" id="milestones">
  <div class="shell">
    <div class="section-heading">
      <span class="section-kicker">Chronology</span>
      <h2>Academic Milestones</h2>
    </div>

    <ul class="lab-timeline">
      {% for item in page.milestones %}
      <li class="lab-timeline-item">
        <div class="timeline-year-chip">{{ item.year }}</div>
        <div class="timeline-body">
          <h3 class="timeline-title">{{ item.title }}</h3>
          <p class="timeline-detail">{{ item.detail }}</p>
        </div>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endblock %}
