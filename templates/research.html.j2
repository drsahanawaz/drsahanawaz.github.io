{% extends "base.html.j2" %}
{% block title %}Research · {{ site.name }}{% endblock %}
{% block description %}{{ page.lead }}{% endblock %}
{% block content %}
<section class="page-hero page-hero--visual page-hero--data">
  <div class="shell">
    <p class="section-kicker">Research</p>
    <h1>{{ page.headline }}</h1>
    <p class="lead">{{ page.lead }}</p>
  </div>
</section>

<section class="section section-visual section-visual--molecules">
  <div class="shell">
    <h2>Current research interests</h2>
    <div class="focus-list">
      {% for item in page.interests %}
      <article class="focus-item">
        <h3>{{ item.title }}</h3>
        <p>{{ item.text }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section-visual section-visual--lab">
  <div class="shell narrow">
    <p class="section-kicker">Doctoral research</p>
    <h2>{{ page.phd.title }}</h2>
    <p class="meta">{{ page.phd.meta }}</p>
    <p>{{ page.phd.text }}</p>
    <blockquote class="pull-quote">{{ page.phd.question }}</blockquote>
  </div>
</section>

<div class="visual-break visual-break--data" role="presentation" aria-hidden="true"></div>

<section class="section section-visual section-visual--data section-visual--dim">
  <div class="shell">
    <h2>Current projects</h2>
    <div class="project-list">
      {% for project in page.projects %}
      <article class="project-item">
        <div class="project-head">
          <h3>{{ project.title }}</h3>
          <span class="status">{{ project.status }}</span>
        </div>
        <p>{{ project.text }}</p>
        <p class="meta">{{ project.tools }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section-visual section-visual--molecules section-visual--dim" id="publications">
  <div class="shell">
    <h2>Publications</h2>
    <div class="pub-list">
      {% for pub in publications %}
      <article class="pub-item">
        <p class="meta">{{ pub.year }} · {{ pub.journal }}{% if pub.volume %} · {{ pub.volume }}{% endif %}</p>
        <h3>{{ pub.title }}</h3>
        <p>{{ pub.summary }}</p>
        {% if pub.doi %}<p class="meta">DOI: {{ pub.doi }}</p>{% endif %}
        <a class="text-link" href="{{ pub.url }}" rel="noopener noreferrer" target="_blank">Read paper →</a>
      </article>
      {% endfor %}
    </div>
    <p><a class="text-link" href="{{ site.links.google_scholar }}" rel="noopener noreferrer" target="_blank">View complete profile on Google Scholar →</a></p>
  </div>
</section>

<section class="section section-visual section-visual--soft">
  <div class="shell">
    <h2>Methods & tools</h2>
    <dl class="methods">
      {% for label, values in page.methods.items() %}
      <div>
        <dt>{{ label }}</dt>
        <dd>{{ values | join(" · ") }}</dd>
      </div>
      {% endfor %}
    </dl>
  </div>
</section>

<section class="section section-visual section-visual--lab">
  <div class="shell connect">
    <h2>Interested in working together?</h2>
    <p>{{ page.collaboration_text }}</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/contact/">Contact me</a>
      <a class="btn btn-ghost" href="{{ site.links.github }}" rel="noopener noreferrer" target="_blank">GitHub</a>
    </div>
  </div>
</section>
{% endblock %}
