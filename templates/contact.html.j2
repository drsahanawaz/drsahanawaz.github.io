{% extends "base.html.j2" %}
{% block title %}Contact · {{ site.name }}{% endblock %}
{% block description %}{{ page.lead }}{% endblock %}
{% block content %}
<section class="page-hero page-hero--visual page-hero--lab">
  <div class="shell">
    <p class="section-kicker">Contact</p>
    <h1>{{ page.headline }}</h1>
    <p class="lead">{{ page.lead }}</p>
  </div>
</section>

<section class="section section-visual section-visual--soft">
  <div class="shell contact-grid">
    {% for channel in page.channels %}
    <article class="contact-channel">
      <p class="meta">{{ channel.label }}</p>
      <a class="email-line" href="{{ channel.href }}">{{ channel.value }}</a>
    </article>
    {% endfor %}
  </div>
</section>

<section class="section section-visual section-visual--data section-visual--dim">
  <div class="shell">
    <h2>Profiles</h2>
    <div class="footer-links profiles">
      <a href="{{ site.links.google_scholar }}" rel="noopener noreferrer" target="_blank">Google Scholar</a>
      <a href="{{ site.links.github }}" rel="noopener noreferrer" target="_blank">GitHub</a>
      <a href="{{ site.links.linkedin }}" rel="noopener noreferrer" target="_blank">LinkedIn</a>
      <a href="{{ site.links.orcid }}" rel="noopener noreferrer" target="_blank">ORCID</a>
    </div>
    <p class="muted" style="margin-top:1.5rem"><a class="text-link" href="{{ site.cv_path }}">Download CV (PDF) →</a></p>
  </div>
</section>
{% endblock %}
