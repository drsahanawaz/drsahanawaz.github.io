<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ site.name }}{% endblock %}</title>
  <meta name="description" content="{% block description %}{{ site.tagline }} — {{ site.full_name }}{% endblock %}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/site.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="shell header-inner">
      <a class="brand" href="/">{{ site.name }}</a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
        <span class="sr-only">Menu</span>
        <span></span><span></span>
      </button>
      <nav id="site-nav" class="site-nav" data-nav>
        {% for item in site.nav %}
        <a href="{{ item.href }}" {% if active == item.key %}aria-current="page"{% endif %}>{{ item.label }}</a>
        {% endfor %}
      </nav>
    </div>
  </header>

  <main id="main">
    {% block content %}{% endblock %}
  </main>

  <footer class="site-footer">
    <div class="shell footer-inner">
      <div>
        <p class="footer-brand">{{ site.full_name }}</p>
        <p class="muted">{{ site.tagline }}</p>
      </div>
      <div class="footer-links">
        <a href="{{ site.links.google_scholar }}" rel="noopener noreferrer" target="_blank">Google Scholar</a>
        <a href="{{ site.links.github }}" rel="noopener noreferrer" target="_blank">GitHub</a>
        <a href="{{ site.links.linkedin }}" rel="noopener noreferrer" target="_blank">LinkedIn</a>
        <a href="{{ site.links.orcid }}" rel="noopener noreferrer" target="_blank">ORCID</a>
      </div>
      <p class="muted small">© {{ site.full_name }} · {{ site.domain }}</p>
    </div>
  </footer>
  <script src="/static/js/site.js" defer></script>
</body>
</html>
