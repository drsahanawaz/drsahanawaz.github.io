{% extends "base.html.j2" %}
{% block title %}{{ site.full_name }} · {{ site.tagline }}{% endblock %}
{% block description %}{{ page.lead }}{% endblock %}
{% block content %}
<section class="hero">
  <div class="hero-media" aria-hidden="true">
    <img class="hero-portrait" src="{{ site.portrait }}" alt="">
    <div class="hero-veil"></div>
    <div class="hero-grid"></div>
    <div class="hero-orb hero-orb-a"></div>
    <div class="hero-orb hero-orb-b"></div>
  </div>
  <div class="shell hero-copy">
    <p class="brand-mark reveal">{{ site.name }}</p>
    <p class="eyebrow reveal delay-1">{{ site.full_name }}</p>
    <h1 class="reveal delay-2">{{ page.headline }}</h1>
    <p class="lead reveal delay-3">{{ page.lead }}</p>
    <div class="cta-row reveal delay-4">
      <a class="btn btn-primary" href="{{ page.cta_primary.href }}">{{ page.cta_primary.label }}</a>
      <a class="btn btn-ghost" href="{{ page.cta_secondary.href }}">{{ page.cta_secondary.label }}</a>
    </div>
  </div>
</section>

<section class="section section-visual section-visual--molecules">
  <div class="shell">
    <p class="section-kicker">{{ page.focus_title }}</p>
    <h2>Chemistry × data science</h2>
    <div class="focus-list">
      {% for item in page.focus_items %}
      <article class="focus-item">
        <h3>{{ item.title }}</h3>
        <p>{{ item.text }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section-visual section-visual--data">
  <div class="shell split">
    <div>
      <p class="section-kicker">{{ page.exploring_title }}</p>
      <h2>{{ page.exploring_headline }}</h2>
      <p>{{ page.exploring_text }}</p>
    </div>
    <ul class="toolkit">
      {% for tool in page.toolkit %}
      <li>{{ tool }}</li>
      {% endfor %}
    </ul>
  </div>
</section>

<div class="visual-break visual-break--lab" role="presentation" aria-hidden="true"></div>

<section class="section section-visual section-visual--soft">
  <div class="shell narrow">
    <p class="section-kicker">{{ page.featured_title }}</p>
    <h2>{{ page.featured_headline }}</h2>
    <p>{{ page.featured_text }}</p>
    <a class="text-link" href="/research/">Read research overview →</a>
  </div>
</section>

<section class="section section-visual section-visual--molecules section-visual--dim">
  <div class="shell">
    <p class="section-kicker">Selected publications</p>
    <h2>Selected research</h2>
    <div class="pub-list">
      {% for pub in publications if pub.featured %}
      <article class="pub-item">
        <p class="meta">{{ pub.journal }} — {{ pub.year }}</p>
        <h3>{{ pub.title }}</h3>
        <p>{{ pub.summary }}</p>
        <a class="text-link" href="{{ pub.url }}" rel="noopener noreferrer" target="_blank">View publication →</a>
      </article>
      {% endfor %}
    </div>
    <p><a class="text-link" href="/research/#publications">All publications →</a></p>
  </div>
</section>

<section class="section section-visual section-visual--data section-visual--dim">
  <div class="shell split">
    <div>
      <p class="section-kicker">{{ page.teaching_title }}</p>
      <h2>{{ page.teaching_headline }}</h2>
      <p>{{ page.teaching_text }}</p>
      <p class="meta">Current teaching includes:</p>
      <ul class="plain-list">
        {% for course in page.courses %}<li>{{ course }}</li>{% endfor %}
      </ul>
      <p class="meta">Teaching across:</p>
      <ul class="plain-list">
        {% for prog in page.programmes %}<li>{{ prog }}</li>{% endfor %}
      </ul>
      <a class="text-link" href="/teaching/">Teaching & student resources →</a>
    </div>
    <div>
      <p class="section-kicker">{{ page.journey_title }}</p>
      <h2>{{ page.journey_headline }}</h2>
      <ol class="timeline">
        {% for step in page.journey %}
        <li>
          <span class="year">{{ step.year }}</span>
          <span class="title">{{ step.title }}</span>
          <span class="place">{{ step.place }}</span>
        </li>
        {% endfor %}
      </ol>
    </div>
  </div>
</section>

<section class="section section-visual section-visual--beyond">
  <div class="shell narrow">
    <p class="section-kicker">{{ page.beyond_title }}</p>
    <h2>{{ page.beyond_headline }}</h2>
    <p>{{ page.beyond_text }}</p>
    <a class="text-link" href="/about/">More about me →</a>
  </div>
</section>

<section class="section section-visual section-visual--soft">
  <div class="shell connect">
    <p class="section-kicker">{{ page.connect_title }}</p>
    <h2>{{ page.connect_headline }}</h2>
    <p>{{ page.connect_text }}</p>
    <p class="email-line"><a href="mailto:{{ site.email_professional }}">{{ site.email_professional }}</a></p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/contact/">Contact me</a>
      <a class="btn btn-ghost" href="{{ site.cv_path }}">Download CV</a>
    </div>
  </div>
</section>
{% endblock %}
